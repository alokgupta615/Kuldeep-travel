# ==========================================
# Kuldeep Travels - Environment Variables Template
# ==========================================
# For Vercel Deployment:
# Add these variables under your Vercel Project -> Settings -> Environment Variables

# --- Razorpay Payment Gateway ---
# Public Key ID (needed for frontend checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id_here

# Server Key ID & Secret (needed for order creation and HMAC signature verification)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# --- Email Notifications (Optional / Nodemailer) ---
EMAIL_USER=kuldeeptravelslko@gmail.com
EMAIL_PASS=your_app_specific_password
OWNER_EMAIL=kuldeeptravelslko@gmail.com

# --- WhatsApp Cloud API / Notifications (Optional) ---
WHATSAPP_TOKEN=your_whatsapp_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
OWNER_PHONE=919936408109

# --- Public Site URL ---
NEXT_PUBLIC_SITE_URL=https://kuldeeptravels.in
